<?xml version="1.0" encoding="utf-8"?>
<!--
  Tela cheia da chamada de senha.

  Substitui o card central: ao chamar, esta tela cobre o conteúdo por alguns segundos e sai. O
  player **continua reproduzindo atrás** — nada aqui fala com o PlayerEngine, então a mídia nunca é
  pausada. É ocultação temporária, não interrupção (especificação §12).

  Tudo é dimensionado por peso, e o número usa autoSize: o X96 aparece em 1080p e em 720p, e um
  tamanho fixo cortaria a senha justamente na TV menor.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/queueScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/queue_screen_bg"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <!-- ============================ FAIXA SUPERIOR ============================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="62"
            android:orientation="horizontal">

            <!-- Coluna institucional. Conteúdo vem de `queue_branding` quando ela for ligada
                 (migration 20260817100000); até lá, texto padrão. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="33"
                android:orientation="vertical">

                <!--
                  Espaço de marca/campanha. É aqui que entram `queue_branding.header_logo_url` e,
                  na Fase 3, o Product Overlay da balança. Enquanto não há fonte de conteúdo, o
                  padding generoso existe para o logo não dominar a coluna: numa TV de loja um
                  símbolo de meio metro compete com a senha, que é o que o cliente precisa ler.
                -->
                <ImageView
                    android:id="@+id/queueBrandImage"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mupa_logo" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/queueBrandCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_queue_panel_white"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:text="@string/queue_screen_brand_caption"
                    android:textColor="@color/queue_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Coluna central: a senha -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="40"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_queue_panel_white"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/queueScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.05"
                        android:text="@string/queue_screen_current"
                        android:textColor="@color/queue_blue"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/queueScreenNumber"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/queue_blue"
                        app:autoSizeMaxTextSize="150sp"
                        app:autoSizeMinTextSize="48sp"
                        app:autoSizeStepGranularity="2sp"
                        app:autoSizeTextType="uniform" />

                    <View
                        android:layout_width="120dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:background="#C9DCF5" />

                    <!-- No MVP1 mostra o SETOR: guichê (`queue_counters`) é MVP2 por decisão de
                         ARQUITETURA §5, e não existe dado de balcão para exibir. -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/queueScreenCounter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textColor="@color/queue_blue"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Selos institucionais -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/queueFeature1"
                        layout="@layout/item_queue_feature"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/queueFeature2"
                        layout="@layout/item_queue_feature"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/queueFeature3"
                        layout="@layout/item_queue_feature"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Coluna das últimas chamadas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="27"
                android:background="@drawable/bg_queue_panel_blue"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:text="@string/queue_last_calls"
                    android:textColor="@color/queue_panel_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="#3A6BC4" />

                <LinearLayout
                    android:id="@+id/queueHistoryList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/queueScreenHistory1"
                        style="@style/QueueScreenHistoryRow" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/queueScreenHistory2"
                        style="@style/QueueScreenHistoryRow" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/queueScreenHistory3"
                        style="@style/QueueScreenHistoryRow" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/queueScreenHistory4"
                        style="@style/QueueScreenHistoryRow" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/queueScreenHistory5"
                        style="@style/QueueScreenHistoryRow" />
                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/queueScreenWaiting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/queue_blue_light"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================ FAIXA INFERIOR ============================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="24"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:background="@drawable/bg_queue_panel_blue"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:text="@string/queue_screen_how_title"
                    android:textColor="@color/queue_panel_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/queueStep1"
                        layout="@layout/item_queue_step"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/queueStep2"
                        layout="@layout/item_queue_step"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/queueStep3"
                        layout="@layout/item_queue_step"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="38"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_queue_panel_white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/queue_screen_qr_text"
                    android:textColor="@color/queue_blue"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      Retorno curto ao atendente para os estados terminais que não são erro (CONTRATO §3).
      Fica FORA da tela cheia: "fila vazia" não justifica cobrir o conteúdo.
    -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/queueToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="60dp"
        android:background="@drawable/bg_queue_toast"
        android:includeFontPadding="false"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp"
        android:textColor="@color/queue_on"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
