<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/enterprise_bg">

    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/layerA"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerViewA"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:resize_mode="zoom"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <ImageView
                android:id="@+id/imageViewA"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <!--
              Slide dinâmico (`type: "web"`). Uma WebView por camada para o item atravessar o
              mesmo crossfade de imagem e vídeo. Fica GONE quando não está em uso, e o
              WebSlideEngine descarrega a página ao sair de cena.
            -->
            <WebView
                android:id="@+id/webViewA"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/layerB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerViewB"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:resize_mode="zoom"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <ImageView
                android:id="@+id/imageViewB"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <!--
              Slide dinâmico (`type: "web"`). Uma WebView por camada para o item atravessar o
              mesmo crossfade de imagem e vídeo. Fica GONE quando não está em uso, e o
              WebSlideEngine descarrega a página ao sair de cena.
            -->
            <WebView
                android:id="@+id/webViewB"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <!--
      Camada de fila (MUPA Queue). Fica FORA do `playerContainer` e acima dele: o player nunca
      sabe que ela existe, e é isso que garante que a chamada de senha não interrompa a mídia
      (especificação §12). Abaixo do `syncOverlay` de propósito — durante uma troca de programação
      a informação de sincronismo tem precedência.
    -->
    <include
        android:id="@+id/queueLayer"
        layout="@layout/view_queue_fullscreen" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/syncOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/enterprise_bg"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/syncContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="720dp">

            <ImageView
                android:id="@+id/syncLogo"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:src="@drawable/ic_mplayer" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/syncStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:includeFontPadding="false"
                android:text="Sincronizando conteúdos..."
                android:textColor="@color/enterprise_on"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/deviceNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/enterprise_on_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/syncCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:includeFontPadding="false"
                android:textColor="@color/enterprise_on"
                android:textSize="14sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/syncFileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:textColor="@color/enterprise_on"
                android:textSize="14sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/syncDetailText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:includeFontPadding="false"
                android:textColor="@color/enterprise_on_muted"
                android:textSize="12sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/syncProgressBar"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="18dp"
                app:indicatorColor="#1E6FFF" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/syncSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:indicatorColor="@color/mupa_cyan" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/deviceIdWatermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="10dp"
        android:alpha="0.38"
        android:textColor="@color/enterprise_on_muted"
        android:textSize="11sp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/apkVersionWatermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:alpha="0.34"
        android:textColor="@color/enterprise_on_muted"
        android:textSize="11sp" />

    <!-- Dev Mode Overlay Container -->
    <LinearLayout
        android:id="@+id/devOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom info boxes -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:background="#DD000000"
            android:padding="8dp"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/txtDevAndroidId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:text="Android ID: -" />

            <TextView
                android:id="@+id/txtDevCompany"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:text="Empresa: -" />
        </LinearLayout>
    </LinearLayout>


</FrameLayout>
